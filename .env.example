# Скопируйте в `.env.local` и подставьте свой ключ OpenRouter (или другого провайдера).
# После сохранения перезапустите: npm run dev
#
# Деплой (Vercel / Netlify): добавьте ту же переменную VITE_API_KEY в Environment Variables
# проекта и выполните новый деплой — без этого ИИ-блоки покажут заглушку.

VITE_API_KEY=

# Опционально (по умолчанию уже заданы в коде для OpenRouter + Qwen 2.5):
# VITE_OPENROUTER_API_KEY=
# VITE_AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# VITE_AI_MODEL=qwen/qwen-2.5-7b-instruct
