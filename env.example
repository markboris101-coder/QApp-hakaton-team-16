# Скопируйте в `.env.local` для Vite (фронт). Не коммитьте с ключами.

# Клиент → OpenRouter напрямую (без бэкенда)
# VITE_API_KEY=

# Клиент → Qwen через бэкенд POST /api/ai/chat (ключ только на сервере, см. .env.server)
# VITE_USE_AI_PROXY=true

# Прод: URL Express без слэша в конце (фронт на Vercel/Netlify, API на Render и т.д.)
# VITE_API_BASE_URL=https://your-api.onrender.com

# --- сервер: скопируйте в `.env.server` в корне проекта или задайте в shell ---
# PORT=8787
# API_KEY=sk-or-v1-...
# OPENROUTER_API_KEY=
# AI_MODEL=qwen/qwen-2.5-7b-instruct
# AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# CORS_ORIGIN=https://your-app.vercel.app
